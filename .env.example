# Google Service Account key
# Locally: paste the raw JSON on a single line
# On Vercel: base64-encode it to avoid escaping issues
#   node -e "console.log(Buffer.from(require('fs').readFileSync('./your-key.json','utf8').trim()).toString('base64'))"
GOOGLE_SERVICE_ACCOUNT_KEY=base64-or-raw-json-here

# Google Drive Shared Drive folder ID
# The service account must have Content Manager access on the Shared Drive
GOOGLE_DRIVE_FOLDER_ID=your-shared-drive-folder-id

# Gemini API key (for note summaries)
# Create key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: override Gemini model
GEMINI_MODEL=gemini-2.5-flash
